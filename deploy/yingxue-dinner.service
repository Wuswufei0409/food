# Managed by the food repository: yingxue-dinner
[Unit]
Description=Yingxue dinner questionnaire
After=network.target

[Service]
Type=simple
User=yingxue-dinner
Group=yingxue-dinner
WorkingDirectory=/opt/yingxue-dinner/current
EnvironmentFile=/etc/yingxue-dinner.env
ExecStart=/opt/yingxue-runtime/bin/node /opt/yingxue-dinner/current/server.mjs
Restart=on-failure
RestartSec=3
UMask=0077
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/yingxue-dinner

[Install]
WantedBy=multi-user.target
